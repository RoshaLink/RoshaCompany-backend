# Server Configuration
PORT=5000
NODE_ENV=development

# Database Environment Toggle
# Set USE_PROD_DB=true if you want to connect to MongoDB Atlas Cloud while in local development
USE_PROD_DB=false

# Local MongoDB Connection (Used when NODE_ENV=development and USE_PROD_DB=false)
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/roshalink

# Production MongoDB Atlas Cloud (Used when NODE_ENV=production or USE_PROD_DB=true)
MONGODB_URI_PROD=mongodb+srv://<user>:<password>@roshacluster.3tsell2.mongodb.net/roshalink?retryWrites=true&w=majority&appName=RoshaCluster

# Fallback MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/roshalink

# Allowed CORS Origins (comma separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174

# JWT Authentication
JWT_SECRET=roshalink_super_secret_jwt_key_2026_!@#
JWT_EXPIRES_IN=7d

# Optional: Resend API integration for email dispatch
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=onboarding@resend.dev
